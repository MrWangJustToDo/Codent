{
  "name": "codent-cli",
  "version": "0.0.1-beta.5",
  "description": "AI coding agent for your terminal — local workspace, local model keys, one install",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-assistant",
    "terminal",
    "tui",
    "local"
  ],
  "license": "MIT",
  "author": {
    "name": "MrWangJustToDo",
    "url": "https://github.com/MrWangJustToDo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MrWangJustToDo/MyAgent.git",
    "directory": "packages/codent"
  },
  "bugs": {
    "url": "https://github.com/MrWangJustToDo/MyAgent/issues"
  },
  "homepage": "https://github.com/MrWangJustToDo/MyAgent#readme",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "codent": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node ./scripts/copy-tree-sitter-grammars.mjs",
    "prepublishOnly": "pnpm run build",
    "dev": "tsdown --watch",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "validate:self-contained": "pnpm run build && node ./scripts/validate-self-contained.mjs",
    "validate:runtime-specifiers": "node ./scripts/validate-runtime-specifiers.mjs",
    "publish:beta": "node ./scripts/publish.mjs"
  },
  "//": "Fully bundled release package. `dependencies` is exactly the four externals that cannot",
  "//runtime": "be inlined — the single-copy renderer and the packages that read their own assets",
  "//bundle": "through `import.meta.url`. Everything else (including all `@codent/*` sources) is",
  "//verify": "inlined into `dist` by tsdown; `pnpm validate:self-contained` asserts it.",
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.75",
    "@my-react/react": "^0.3.30",
    "@my-react/react-terminal": "^0.0.31",
    "web-tree-sitter": "^0.25.10"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5",
    "isolated-vm": "7.0.1"
  },
  "devDependencies": {
    "@codent/acp": "workspace:*",
    "@codent/app": "workspace:*",
    "@codent/core": "workspace:*",
    "@codent/node": "workspace:*",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.14",
    "dotenv": "^18.0.6",
    "tsdown": "^0.23.0",
    "typescript": "^5.6.3",
    "zod": "^4.5.4"
  }
}
