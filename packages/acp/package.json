{
  "name": "@codent/acp",
  "version": "0.0.1",
  "description": "Agent Client Protocol (ACP) agent-side host for Codent",
  "license": "MIT",
  "author": {
    "name": "MrWangJustToDo",
    "url": "https://github.com/MrWangJustToDo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MrWangJustToDo/Codent.git",
    "directory": "packages/acp"
  },
  "bugs": {
    "url": "https://github.com/MrWangJustToDo/Codent/issues"
  },
  "homepage": "https://github.com/MrWangJustToDo/Codent#readme",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "codent-acp": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "dev": "tsdown --watch",
    "start": "node dist/bin.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "validate:acp": "pnpm run build && node scripts/validate-acp.mjs && node scripts/validate-acp-projection.mjs && node scripts/validate-acp-elicitation.mjs && node scripts/validate-acp-text-ask.mjs && node scripts/validate-acp-turn-ids.mjs && node scripts/validate-acp-live-turns.mjs && node scripts/validate-acp-catalog.mjs && node scripts/validate-acp-mcp.mjs && node scripts/validate-acp-client-env.mjs && node scripts/validate-acp-client-env-terminal.mjs && node scripts/validate-acp-client-env-bootstrap.mjs && node scripts/validate-acp-auto-approval.mjs && node scripts/validate-acp-command-args.mjs && node scripts/validate-acp-subagents.mjs && node scripts/validate-acp-subagents-host.mjs && node scripts/validate-acp-conformance.mjs",
    "validate:acp:conformance": "pnpm run build && node scripts/validate-acp-conformance.mjs",
    "validate:acp:command-args": "pnpm run build && node scripts/validate-acp-command-args.mjs",
    "validate:acp:subagents": "pnpm run build && node scripts/validate-acp-subagents.mjs && node scripts/validate-acp-subagents-host.mjs",
    "validate:acp:auto-approval": "pnpm run build && node scripts/validate-acp-auto-approval.mjs",
    "validate:acp:turn-ids": "pnpm run build && node scripts/validate-acp-turn-ids.mjs",
    "validate:acp:projection": "pnpm run build && node scripts/validate-acp-projection.mjs",
    "validate:acp:elicitation": "pnpm run build && node scripts/validate-acp-elicitation.mjs",
    "validate:acp:text-ask": "pnpm run build && node scripts/validate-acp-text-ask.mjs",
    "validate:acp:live-turns": "pnpm run build && node scripts/validate-acp-live-turns.mjs",
    "validate:acp:catalog": "pnpm run build && node scripts/validate-acp-catalog.mjs",
    "validate:acp:mcp": "pnpm run build && node scripts/validate-acp-mcp.mjs",
    "validate:acp:client-env": "pnpm run build && node scripts/validate-acp-client-env.mjs",
    "validate:acp:terminal": "pnpm run build && node scripts/validate-acp-client-env-terminal.mjs",
    "validate:acp:bootstrap": "pnpm run build && node scripts/validate-acp-client-env-bootstrap.mjs",
    "validate:host-tool-names": "node scripts/validate-host-tool-names.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@codent/core": "workspace:*",
    "@codent/node": "workspace:*",
    "@tanstack/ai": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsdown": "^0.23.0",
    "typescript": "^5.6.3"
  }
}
