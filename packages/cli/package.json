{
  "name": "@codent/cli",
  "version": "0.0.1",
  "description": "CLI for Codent",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-assistant",
    "terminal"
  ],
  "license": "MIT",
  "author": {
    "name": "MrWangJustToDo",
    "url": "https://github.com/MrWangJustToDo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MrWangJustToDo/MyAgent.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/MrWangJustToDo/MyAgent/issues"
  },
  "homepage": "https://github.com/MrWangJustToDo/MyAgent#readme",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "codent": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./host": {
      "types": "./dist/host.d.mts",
      "import": "./dist/host.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "dev": "tsdown --watch",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codent/acp": "workspace:*",
    "@codent/core": "workspace:*",
    "@codent/node": "workspace:*",
    "@codent/server": "workspace:*",
    "@my-react/react": "^0.3.30",
    "@my-react/react-terminal": "^0.0.31"
  },
  "devDependencies": {
    "@codent/app": "workspace:*",
    "@my-react/react": "^0.3.30",
    "@my-react/react-terminal": "^0.0.31",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.14",
    "dotenv": "^18.0.6",
    "reactivity-store": "^0.4.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.6.3",
    "zod": "^4.5.4"
  }
}
