{
  "name": "@codent/playground",
  "version": "0.0.1",
  "private": true,
  "description": "Browser playground — WebContainer CoreEnv + shared @codent/app",
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:all:playground": "node ../../scripts/run-all-validators.mjs --dir packages/playground",
    "validate:workspace-path": "node ./scripts/validate-workspace-path.mjs",
    "validate:resolve-fetch-proxy": "node ./scripts/validate-resolve-fetch-proxy.mjs",
    "validate:preview-ports": "node ./scripts/validate-preview-ports.mjs",
    "validate:workspace-export-selection": "node ./scripts/validate-workspace-export-selection.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@codent/app": "workspace:*",
    "@codent/core": "workspace:*",
    "@codent/server": "workspace:*",
    "@my-react/react": "^0.3.30",
    "@my-react/react-dom": "^0.3.30",
    "@my-react/react-terminal": "^0.0.31",
    "@webcontainer/api": "^1.6.4",
    "@xterm/addon-webgl": "^0.19.0",
    "chalk": "^5.6.2",
    "fflate": "^0.8.2",
    "ink-stream-markdown": "^0.0.15",
    "monaco-editor": "^0.56.0",
    "reactivity-store": "^0.4.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.25.10"
  },
  "devDependencies": {
    "@my-react/react-refresh": "^0.3.30",
    "@my-react/react-vite": "^0.0.36",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.6.3",
    "vite": "^8.3.3"
  }
}
