{
  "name": "@codent/mcp-server",
  "version": "0.0.1",
  "description": "MCP server for Codent",
  "license": "MIT",
  "author": {
    "name": "MrWangJustToDo",
    "url": "https://github.com/MrWangJustToDo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MrWangJustToDo/Codent.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/MrWangJustToDo/Codent/issues"
  },
  "homepage": "https://github.com/MrWangJustToDo/Codent#readme",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "codent-mcp-server": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "dev": "tsdown --watch",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cyanheads/mcp-ts-core": "^0.13.12",
    "screenshot-desktop": "^1.15.6",
    "sharp": "^0.35.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsdown": "^0.23.0",
    "typescript": "^5.6.3"
  }
}
