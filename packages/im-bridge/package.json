{
  "name": "@codent/im-bridge",
  "version": "0.0.1",
  "description": "Generic IM bridge for Codent — connects chat platforms (Telegram, …) to an AgentSession server",
  "license": "MIT",
  "author": {
    "name": "MrWangJustToDo",
    "url": "https://github.com/MrWangJustToDo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MrWangJustToDo/MyAgent.git",
    "directory": "packages/im-bridge"
  },
  "bugs": {
    "url": "https://github.com/MrWangJustToDo/MyAgent/issues"
  },
  "homepage": "https://github.com/MrWangJustToDo/MyAgent#readme",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs"
    }
  },
  "bin": {
    "codent-im-bridge": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "dev": "tsdown --watch",
    "start": "node dist/cli.mjs",
    "validate:all:im-bridge": "node ../../scripts/run-all-validators.mjs --dir packages/im-bridge",
    "validate:bridge": "pnpm run build && node scripts/validate-bridge.mjs && node scripts/validate-bridge-groups.mjs && node scripts/validate-bridge-tool-preview.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codent/core": "workspace:*",
    "@codent/node": "workspace:*",
    "@codent/server": "workspace:*",
    "@tanstack/ai": "^0.68.0",
    "dotenv": "^18.0.6",
    "grammy": "^1.36.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsdown": "^0.23.0",
    "typescript": "^5.6.3"
  }
}
