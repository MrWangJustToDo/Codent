{
  "name": "@codent/app",
  "version": "0.0.1",
  "description": "Shared app components and hooks for Codent (CLI + Web)",
  "keywords": [
    "ai",
    "agent",
    "react",
    "terminal-ui",
    "tui"
  ],
  "license": "MIT",
  "author": {
    "name": "MrWangJustToDo",
    "url": "https://github.com/MrWangJustToDo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MrWangJustToDo/Codent.git",
    "directory": "packages/app"
  },
  "bugs": {
    "url": "https://github.com/MrWangJustToDo/Codent/issues"
  },
  "homepage": "https://github.com/MrWangJustToDo/Codent#readme",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:release": "tsdown --config tsdown.config.release.ts",
    "prepublishOnly": "pnpm run build:release",
    "dev": "tsdown --watch",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate:all:app": "node ../../scripts/run-all-validators.mjs --dir packages/app",
    "validate:theme-palettes": "node ./scripts/validate-theme-palettes.mjs",
    "validate:core-imports": "node ./scripts/validate-core-imports.mjs",
    "validate:no-duplicate-core-helpers": "node ./scripts/validate-no-duplicate-core-helpers.mjs",
    "validate:presentation-helpers": "node ./scripts/validate-presentation-helpers.mjs",
    "validate:session-only-smoke": "pnpm run build && pnpm --filter @codent/core build && pnpm --filter @codent/node build && node ./scripts/validate-session-only-smoke.mjs",
    "validate:models-config-edit": "node ./scripts/validate-models-config-edit.mjs",
    "validate:render-smoke": "tsdown --config ./scripts/render-smoke/tsdown.config.ts && node ./scripts/render-smoke/run.mjs",
    "validate:workspace-refresh": "node ./scripts/validate-workspace-refresh-check.mjs",
    "validate:command-catalog": "node scripts/validate-command-catalog.mjs",
    "validate:host-tool-names": "pnpm run build && node scripts/validate-host-tool-names.mjs"
  },
  "//": "Two build configurations. `build` (default) keeps third-party dependencies external so",
  "//bundling": "in-repo hosts resolve each one once and in the form they need; `build:release`",
  "//release": "inlines them for the fully bundled release / publishing paths. See tsdown.shared.ts.",
  "dependencies": {
    "@codent/core": "workspace:*",
    "@my-react/react": "^0.3.30",
    "@my-react/react-terminal": "^0.0.31",
    "@tanstack/ai": "^0.68.0",
    "highlight.js": "^11.11.1",
    "lodash-es": "^4.17.23"
  },
  "devDependencies": {
    "@git-diff-view/cli": "^0.1.10",
    "@git-diff-view/core": "^0.1.7",
    "@git-diff-view/file": "^0.1.7",
    "@git-diff-view/lowlight": "^0.1.7",
    "@m234/nerd-fonts": "^0.5.1",
    "@my-react/react": "^0.3.30",
    "@my-react/react-terminal": "^0.0.31",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.14",
    "chalk": "^5.6.2",
    "diff": "^9.0.0",
    "ink-stream-markdown": "^0.0.14",
    "reactivity-store": "^0.4.0",
    "socket.io-client": "^4.8.4",
    "tsdown": "^0.23.0",
    "typescript": "^5.6.3"
  }
}
